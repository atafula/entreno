rules_version = '2';
// Reglas para Entreno (proyecto entreno-31153).
// Cópialas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validUser(d) {
      // 'rutinas' y 'rutinasTs' son del formato antiguo (todas juntas); ahora cada rutina es un documento aparte
      return d.keys().hasOnly(['rutinas', 'rutinasTs', 'rutinasV2', 'perfil'])
        && (!('rutinas' in d) || (d.rutinas is list && d.rutinas.size() <= 100))
        && (!('rutinasTs' in d) || d.rutinasTs is number)
        && (!('rutinasV2' in d) || d.rutinasV2 is bool)
        && (!('perfil' in d) || validPerfil(d.perfil));
    }

    // Perfil de la cuenta (nombre, @usuario, bio, foto de 256 px en base64, sexo, altura)
    function validPerfil(p) {
      return p is map
        && p.keys().hasOnly(['nombre', 'usuario', 'bio', 'foto', 'sexo', 'altura', 'rev', 'upd'])
        && (!('nombre' in p) || (p.nombre is string && p.nombre.size() <= 40))
        && (!('usuario' in p) || (p.usuario is string && p.usuario.size() <= 40))
        && (!('bio' in p) || (p.bio is string && p.bio.size() <= 160))
        && (!('foto' in p) || (p.foto is string && p.foto.size() <= 200000))
        && (!('sexo' in p) || p.sexo is string)
        && (!('altura' in p) || p.altura is number)
        && (!('rev' in p) || p.rev is number)
        && (!('upd' in p) || p.upd is number);
    }

    function validRutina(d) {
      return d.keys().hasOnly(['name', 'days', 'exercises', 'pos', 'rev', 'upd'])
        && d.name is string && d.name.size() <= 100
        && d.exercises is list && d.exercises.size() <= 100
        && (!('days' in d) || (d.days is list && d.days.size() <= 7))
        && (!('pos' in d) || d.pos is number)
        && (!('rev' in d) || d.rev is number)
        && (!('upd' in d) || d.upd is number);
    }

    function validSesion(d) {
      return d.keys().hasOnly(['date', 'routine', 'routineId', 'sets', 'seconds', 'ts', 'rev', 'upd', 'nota', 'foto'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.routine is string && d.routine.size() <= 100
        && d.sets is list && d.sets.size() <= 500
        && (!('seconds' in d) || d.seconds is number)
        && (!('routineId' in d) || (d.routineId is string && d.routineId.size() <= 80))
        && (!('nota' in d) || (d.nota is string && d.nota.size() <= 1000))
        && (!('foto' in d) || (d.foto is string && d.foto.size() <= 600000))
        && (!('ts' in d) || d.ts is number)
        && (!('rev' in d) || d.rev is number)
        && (!('upd' in d) || d.upd is number);
    }

    function validCaminata(d) {
      return d.keys().hasOnly(['date', 'seconds', 'meters', 'ts', 'rev', 'upd'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.seconds is number && d.meters is number
        && (!('ts' in d) || d.ts is number)
        && (!('rev' in d) || d.rev is number)
        && (!('upd' in d) || d.upd is number);
    }

    match /users/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid) && validUser(request.resource.data);

      match /sesiones/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validSesion(request.resource.data);
      }
      match /rutinas/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validRutina(request.resource.data);
      }
      match /caminatas/{id} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && validCaminata(request.resource.data);
      }
    }
  }
}
